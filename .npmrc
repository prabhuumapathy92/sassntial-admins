auto-install-peers=true

# The backend pins React 18 (@medusajs/medusa peer-requires react-dom ^18.3.1)
# while the storefront needs React 19 for Next 15. React 19 has to be the
# hoisted copy, because Next resolves react-dom from the repo root and mixing
# element types there fails the production build (minified React error #31).
# npm's peer resolver rejects that combination, so peer conflicts are accepted
# here; the backend still gets its own React 18 nested under apps/backend.
legacy-peer-deps=true
