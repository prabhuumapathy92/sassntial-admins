{
  "compilerOptions": {
    "target": "ES2021",
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "./",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "strictNullChecks": true
  },
  /**
   * ts-node loads TypeScript modules (medusa-config.ts, src/modules/*) at
   * runtime. Its swc transpiler needs a native .node binary, which Windows
   * Application Control refuses to load on some machines — that failure takes
   * down `medusa develop`, `db:migrate` and `db:generate` alike. The built-in
   * TypeScript transpiler is pure JavaScript and always loads; transpileOnly
   * keeps it roughly as fast by skipping the type check, which `medusa build`
   * and `tsc --noEmit` already cover.
   */
  "ts-node": {
    "swc": false,
    "transpileOnly": true
  },
  "include": [
    "**/*",
    ".medusa/types/*"
  ],
  "exclude": [
    "node_modules",
    ".medusa/server",
    ".medusa/admin",
    ".cache",
    "eslint.config.*",
  ]
}
