{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /**
     * The repo root carries @types/react 19 for the Next.js storefront, so
     * packages resolved from there (@medusajs/ui, @medusajs/icons) would type
     * against React 19 while admin sources type against apps/backend's React 18
     * copy. Two ReactNode types then make every @medusajs/ui component an
     * invalid JSX element. These paths do for the type layer what
     * `admin.vite.resolve.dedupe` in medusa-config.ts does for the bundle:
     * collapse everything onto the React 18 types the admin actually runs on.
     */
    "baseUrl": ".",
    "paths": {
      "react": ["../../node_modules/@types/react"],
      "react/*": ["../../node_modules/@types/react/*"],
      "react-dom": ["../../node_modules/@types/react-dom"],
      "react-dom/*": ["../../node_modules/@types/react-dom/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".", "../../.medusa/types/plugin-augmentations.d.ts"]
}
